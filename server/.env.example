# Copy to .env and adjust. All values are optional in local dev.

# Port the API listens on (Vite proxies /api → this port).
CHESSIFY_PORT=3001

# Secret used to sign session JWTs. Set a long random string in production!
JWT_SECRET=dev-secret-change-me

# Bootstrap admin: the FIRST account that signs up with this exact username
# is created with admin rights (isAdmin: true) and can open /admin.
# Further admins can then be promoted from the admin panel's Users table.
# Example: set ADMIN_USERNAME=bhavy, then sign up as "bhavy" → you're admin.
ADMIN_USERNAME=admin
