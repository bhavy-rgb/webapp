# Use server/.env or the root .env; process environment takes precedence.
CHESSIFY_PORT=3001
JWT_SECRET=replace-with-a-long-random-string

# Fixed admin username: ARISE. Supply a private bcrypt hash with cost 10–16.
# Provisioned before the server listens; never granted by public signup.
ADMIN_PASSWORD_HASH=
# Optional existing admin username to rename while retaining its ID and history.
ADMIN_MIGRATE_FROM=
