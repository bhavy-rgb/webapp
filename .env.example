# Server (CHESSIFY_PORT avoids clashes with a shell-level PORT env var)
CHESSIFY_PORT=3001
JWT_SECRET=replace-with-a-long-random-string

# Fixed admin username: ARISE. Set a bcrypt hash (cost 10–16) privately.
# Never commit the real password or hash. Missing hash disables provisioning
# in development and prevents production startup. Public signup cannot claim ARISE.
ADMIN_PASSWORD_HASH=
# Optional one-time rename of an EXISTING ADMIN, preserving ID and game history.
# Set to the previous admin username when migrating; leave empty on fresh installs.
ADMIN_MIGRATE_FROM=

# Client (used by the Vite dev server proxy — server URL)
VITE_API_PROXY_TARGET=http://localhost:3001
